# Frontend environment variables
# Copy this file to .env.local and fill in values for local development

# WebSocket server URL (port 5000) — used for presence and chat
VITE_WEBSOCKET_SERVER_URL=ws://localhost:5000

# Yjs WebSocket server URL (port 5001) — used for CRDT document sync
VITE_YJS_SERVER_URL=ws://localhost:5001
